APP_NAME=Fotostation
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: docker-compose.dev.yml. In Laravel Cloud setzt die angehängte
# PostgreSQL-Datenbank diese Werte automatisch.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fotostation
DB_USERNAME=fotostation
DB_PASSWORD=secret

# Cookie-Sessions: Galerie-Besuche wecken die Datenbank nicht unnötig.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Fotostation ------------------------------------------------------------

# Lokale Buckets (MinIO aus docker-compose.dev.yml). In Laravel Cloud die
# Buckets mit den Disk-Namen "photos-private" und "photos-public" anhängen;
# dann werden diese Werte ignoriert.
PHOTOS_KEY=fotostation
PHOTOS_SECRET=fotostation-secret
PHOTOS_ENDPOINT=http://localhost:9000
PHOTOS_PUBLIC_URL=http://localhost:9000/photos-public
PHOTOS_PRIVATE_BUCKET=photos-private
PHOTOS_PUBLIC_BUCKET=photos-public
PHOTOS_PATH_STYLE=true

# Bildverarbeitungs-Worker (eigener Server). Token: openssl rand -hex 32
# false = einfacher Modus ohne Worker (nur PHP: Zuschnitt, manuelles Verpixeln,
# keine Gesichtserkennung, kein Bildabgleich, kein Zeitraffer)
CV_WORKER_ENABLED=false
CV_WORKER_URL=http://localhost:8000
CV_WORKER_TOKEN=dev-token
# Unter 90 s bleiben (Laravel Cloud Managed Queues, Flex)
CV_WORKER_TIMEOUT=60

# Name der (einzigen) Queue; in Laravel Cloud eine Managed Queue mit diesem Namen
FOTOSTATION_QUEUE=uploads

# Spamschutz ALTCHA (https://altcha.org), läuft komplett auf diesem Server.
# ALTCHA_HMAC_KEY leer lassen = Schlüssel wird aus APP_KEY abgeleitet.
ALTCHA_ENABLED=true
ALTCHA_HMAC_KEY=
ALTCHA_COST=5000

# Benachrichtigungen bei Meldungen und Verarbeitungsfehlern
FOTOSTATION_ADMIN_EMAIL=

# Nächtliches Zeitfenster für Rendering und Aufräumen
FOTOSTATION_NIGHTLY_AT=03:00
FOTOSTATION_RENDER_FPS=4
