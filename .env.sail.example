# Laravel Sail (docker-compose.yml). Verwendung: cp .env.sail.example .env
# Danach: sail artisan key:generate

APP_NAME=Fotostation
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Ports auf dem Rechner (Standard: App 80, Vite 5173)
APP_PORT=80
VITE_PORT=5173

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL-Container "pgsql" aus docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fotostation
DB_USERNAME=fotostation
DB_PASSWORD=secret

# Cookie-Sessions: Galerie-Besuche wecken die Datenbank nicht unnötig.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit: Oberfläche unter http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Fotostation ------------------------------------------------------------

# RustFS-Container "rustfs" (S3) aus docker-compose.yml. Der Hostname "rustfs"
# muss auch auf deinem Rechner auflösen: "127.0.0.1 rustfs" in /etc/hosts.
# Grund: Vorsignierte URLs sind an den Hostnamen gebunden; so funktionieren
# sie im Browser (Moderation), in Laravel und im cv-worker gleichermaßen.
# Konsole: http://localhost:9001 (PHOTOS_KEY / PHOTOS_SECRET)
PHOTOS_KEY=fotostation
PHOTOS_SECRET=fotostation-secret
PHOTOS_ENDPOINT=http://rustfs:9000
PHOTOS_PUBLIC_URL=http://rustfs:9000/photos-public
PHOTOS_PRIVATE_BUCKET=photos-private
PHOTOS_PUBLIC_BUCKET=photos-public
PHOTOS_PATH_STYLE=true

# cv-worker-Container aus docker-compose.yml (vom Rechner aus: http://localhost:8001)
# false = einfacher Modus ohne Worker (nur PHP: Zuschnitt, manuelles Verpixeln,
# keine Gesichtserkennung, kein Bildabgleich, kein Zeitraffer)
CV_WORKER_ENABLED=true
CV_WORKER_URL=http://cv-worker:8000
CV_WORKER_TOKEN=dev-token
# Unter 90 s bleiben (Laravel Cloud Managed Queues, Flex)
CV_WORKER_TIMEOUT=60

# Name der (einzigen) Queue; in Laravel Cloud eine Managed Queue mit diesem Namen
FOTOSTATION_QUEUE=uploads

# Spamschutz ALTCHA (https://altcha.org), läuft komplett auf diesem Server.
# ALTCHA_HMAC_KEY leer lassen = Schlüssel wird aus APP_KEY abgeleitet.
ALTCHA_ENABLED=true
ALTCHA_HMAC_KEY=
ALTCHA_COST=5000

# Benachrichtigungen bei Meldungen und Verarbeitungsfehlern
# Lokal landen die Mails in Mailpit
FOTOSTATION_ADMIN_EMAIL=admin@fotostation.test

# Nächtliches Zeitfenster für Rendering und Aufräumen
# Lokal hoch, damit Tests nicht nach 3 Uploads mit 429 enden (Produktion: 3 bzw. 500)
FOTOSTATION_UPLOADS_PER_IP_HOUR=1000
FOTOSTATION_UPLOADS_PER_STATION_DAY=10000

# Ab welchem Anteil echter Fotopixel (Rest aus dem Referenzbild ergänzt) ein
# Foto in der Moderation als auffällig gilt und nicht sammelfreigegeben wird
FOTOSTATION_MIN_COVERAGE=0.85

FOTOSTATION_NIGHTLY_AT=03:00
FOTOSTATION_RENDER_FPS=4

# --- Sail --------------------------------------------------------------------

# Immer diese Compose-Datei verwenden, auch wenn daneben eine compose.yaml
# liegt (z. B. von "php artisan sail:install"; Docker bevorzugt sonst diese).
COMPOSE_FILE=docker-compose.yml

# Weitere Ports auf dem Rechner, bei Konflikten hier ändern
FORWARD_DB_PORT=5432
FORWARD_RUSTFS_PORT=9000
FORWARD_RUSTFS_CONSOLE_PORT=9001
FORWARD_CV_WORKER_PORT=8001
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_ADMINER_PORT=8080

# Xdebug: z. B. "develop,debug" (danach sail up -d)
SAIL_XDEBUG_MODE=off
