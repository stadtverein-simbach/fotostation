# Domain des Workers, z. B. cv.fotostation.example.de (DNS-A-Record auf den VPS)
WORKER_DOMAIN=cv.example.de

# Gleicher Wert wie CV_WORKER_TOKEN in Laravel Cloud. Erzeugen: openssl rand -hex 32
WORKER_TOKEN=

# Nur URLs der eigenen Buckets zulassen (kommagetrennt). Leer = alle.
# Den Host findest du in einer vorsignierten URL aus Laravel (z. B. in den Logs).
ALLOWED_URL_PREFIXES=

# Schwellen für Bildabgleich und Gesichter (Standard ist meist passend)
MATCH_EDGE=1600
MATCH_RATIO=0.75
FACE_SCORE=0.6
MAX_DOWNLOAD_MB=30
LOG_LEVEL=INFO
